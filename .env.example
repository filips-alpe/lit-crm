# Postgres connection string used by Prisma.
# The dev container in docker-compose.yml maps to host port 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lit_crm?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/lit_crm?schema=public"

# Test database for the vitest `server` project. REQUIRED to run server tests:
# they TRUNCATE tables between cases, so the suite refuses to run unless this is
# set AND different from DATABASE_URL (otherwise it would wipe your dev data).
#   - Local docker:  docker exec lit-crm-postgres psql -U postgres -c 'CREATE DATABASE lit_crm_test;'
#   - Neon:          create a branch (or a second database) in the console / `neonctl branches create`
# then migrate it once: `DATABASE_URL=$TEST_DATABASE_URL bunx prisma migrate deploy`
# (a Neon branch copied from the dev DB already has the schema).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lit_crm_test?schema=public"

# Secret used to HMAC-sign the session cookie. Must be at least 16 characters.
AUTH_SECRET="change-me-to-a-long-random-string"
